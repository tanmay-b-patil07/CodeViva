# Database
# Development-only default; configure a dedicated DATABASE_URL for production.
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/codecomp
# Set ENVIRONMENT=production and provide production-only values before deployment.
ENVIRONMENT=development
# Set true only for a disposable development/test database before using db_tools reset-demo.
ALLOW_DATABASE_RESET=false

# Authentication
# Development-only placeholder; replace with a unique random secret in production.
JWT_SECRET=codeviva-development-only-secret-replace-before-production-2026
JWT_EXPIRE_MINUTES=480

# Teacher registration
TEACHER_INVITE_CODE=choose-a-code

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# AI providers
# Unit tests and local development stay offline by default. Set to live only
# when intentionally making provider requests.
CODEVIVA_AI_MODE=mock
CODEVIVA_AI_PROVIDER_PRACTICE=agnes
CODEVIVA_AI_PROVIDER_EXAM=grok
CODEVIVA_AI_PROVIDER_GRADING=grok
XAI_API_KEY=your-xai-api-key
AGNES_API_KEY=your-agnes-api-key
XAI_BASE_URL=https://api.x.ai/v1
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
XAI_MODEL=your-xai-model
AGNES_MODEL=your-agnes-model
CODEVIVA_AI_TIMEOUT=20
CODEVIVA_AI_MAX_RETRIES=1
CODEVIVA_AI_MAX_CONCURRENCY=3

# Models
# Legacy task-specific fallbacks remain supported, but are intentionally unset.
# XAI_MODEL or AGNES_MODEL for the selected provider always wins. Otherwise,
# CODEVIVA_MODEL_<TASK> wins, then MODEL_<TASK>.
# MODEL_PRACTICE=
# MODEL_EXAM=
# MODEL_GRADING=

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Cookies
# Production requires true; local HTTP development uses false.
COOKIE_SECURE=false

# Exam generation
GENERATION_LEAD_MINUTES=30
CONFIDENCE_REVIEW_THRESHOLD=0.6
EXAM_GRACE_SECONDS=30
