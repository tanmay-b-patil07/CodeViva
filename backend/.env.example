# Database
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/codecomp

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# Teacher registration
TEACHER_INVITE_CODE=

# Agnes AI (OpenAI-compatible API)
AGNES_API_KEY=your-agnes-api-key
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1

# Models
MODEL_PRACTICE=agnes-2.5-flash
MODEL_EXAM=agnes-2.5-flash

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Cookies
COOKIE_SECURE=false

# Exam generation
GENERATION_LEAD_MINUTES=30
CONFIDENCE_REVIEW_THRESHOLD=0.6